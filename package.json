{
  "name": "dslop",
  "version": "1.8.2",
  "description": "Detect Similar/Duplicate Lines Of Programming - Find code duplication in your codebase",
  "type": "module",
  "main": "./dist/index.cjs",
  "bin": {
    "dslop": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun run index.ts",
    "build": "esbuild index.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs && sed -i '' '1d' ./dist/index.cjs && VERSION=$(node -p \"require('./package.json').version\") && sed -i '' \"s/__INJECT_VERSION__/$VERSION/g\" ./dist/index.cjs && echo '#!/usr/bin/env node' | cat - ./dist/index.cjs > temp && mv temp ./dist/index.cjs && chmod +x ./dist/index.cjs",
    "build:binary": "bun build --compile ./index.ts --outfile dslop",
    "prepublishOnly": "bun run build",
    "changelog": "bunx changelogen --output CHANGELOG.md",
    "release": "bunx changelogen --release --push && npm publish",
    "release:minor": "bunx changelogen --release --minor --push && npm publish",
    "release:major": "bunx changelogen --release --major --push && npm publish"
  },
  "keywords": [
    "duplicate",
    "code",
    "detection",
    "cli",
    "lint",
    "copy-paste",
    "refactor",
    "monorepo",
    "dry"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/turf-sports/dslop.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "latest",
    "changelogen": "^0.6.2",
    "esbuild": "^0.27.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "glob": "^13.0.0"
  }
}
